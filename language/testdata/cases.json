{
  "about": "Expression cases shared by every implementation of the expression language. Each case compiles src with the standard library and a scope of env's keys plus scope, evaluates it with env, and expects want (a JSON number, string or bool) or error: \"compile\" or \"eval\".",
  "cases": [
    {"src": "1 + 2 * 3", "want": 7},
    {"src": "(1 + 2) * 3", "want": 9},
    {"src": "10 - 4 - 3", "want": 3},
    {"src": "7 % 3", "want": 1},
    {"src": "-2 * -3", "want": 6},
    {"src": "1.5e2", "want": 150},
    {"src": ".5 + .25", "want": 0.75},
    {"src": "\"slime-\" + 3", "want": "slime-3"},
    {"src": "1 + 2 + \"x\"", "want": "3x"},
    {"src": "\"a\" + true", "want": "atrue"},
    {"src": "\"say \\\"hi\\\" \\\\o/\"", "want": "say \"hi\" \\o/"},
    {"src": "\"image/slime-\" + str(count % 3)", "env": {"count": 4}, "want": "image/slime-1"},
    {"src": "hour >= 20 || hour < 6 ? \"night\" : \"day\"", "env": {"hour": 22.5}, "want": "night"},
    {"src": "hour >= 20 || hour < 6 ? \"night\" : \"day\"", "env": {"hour": 12}, "want": "day"},
    {"src": "clamp(1 + count * 0.25, 1, 2)", "env": {"count": 2}, "want": 1.5},
    {"src": "clamp(1 + count * 0.25, 1, 2)", "env": {"count": 9}, "want": 2},
    {"src": "true ? 1 : false ? 2 : 3", "want": 1},
    {"src": "false ? 1 : false ? 2 : 3", "want": 3},
    {"src": "1 < 2 && 2 <= 2 && 3 > 2 && 3 >= 4 == false", "want": true},
    {"src": "\"apple\" < \"banana\"", "want": true},
    {"src": "\"a\" == \"a\" && 1 != 2", "want": true},
    {"src": "!(1 == 1)", "want": false},
    {"src": "false && missing", "scope": ["missing"], "want": false},
    {"src": "true || missing", "scope": ["missing"], "want": true},
    {"src": "min(3, 1, 2) + max(4, 6)", "want": 7},
    {"src": "floor(2.7) + ceil(2.1) + round(2.5) + abs(-1)", "want": 9},
    {"src": "num(\" 2.5 \") * 2", "want": 5},
    {"src": "num(true) + num(false)", "want": 1},
    {"src": "int(-2.7)", "want": -2},
    {"src": "int(\"3.9\")", "want": 3},
    {"src": "str(0.25) + str(3) + str(false)", "want": "0.253false"},
    {"src": "bool(0) || bool(\"true\")", "want": true},
    {"src": "bool(2)", "want": true},
    {"src": "len(\"héllo\")", "want": 5},
    {"src": "concat(\"a\", 1, true)", "want": "a1true"},
    {"src": "phase + \"-\" + seq", "env": {"phase": "night", "seq": 7}, "want": "night-7"},

    {"src": "1 / 0", "error": "eval"},
    {"src": "count % 0", "env": {"count": 1}, "error": "eval"},
    {"src": "missing + 1", "scope": ["missing"], "error": "eval"},
    {"src": "1 - \"a\"", "error": "eval"},
    {"src": "1 < \"a\"", "error": "eval"},
    {"src": "1 == \"1\"", "error": "eval"},
    {"src": "true < false", "error": "eval"},
    {"src": "1 && true", "error": "eval"},
    {"src": "!1", "error": "eval"},
    {"src": "-\"a\"", "error": "eval"},
    {"src": "1 ? 2 : 3", "error": "eval"},
    {"src": "num(\"abc\")", "error": "eval"},
    {"src": "bool(\"yes\")", "error": "eval"},
    {"src": "min(1, \"a\")", "error": "eval"},
    {"src": "len(3)", "error": "eval"},
    {"src": "1e308 * 10", "error": "eval"},

    {"src": "", "error": "compile"},
    {"src": "1 +", "error": "compile"},
    {"src": "(1 + 2", "error": "compile"},
    {"src": "1 2", "error": "compile"},
    {"src": "true ? 1", "error": "compile"},
    {"src": "unknown + 1", "error": "compile"},
    {"src": "nope(1)", "error": "compile"},
    {"src": "clamp(1, 2)", "error": "compile"},
    {"src": "abs(1, 2)", "error": "compile"},
    {"src": "\"open", "error": "compile"},
    {"src": "\"bad \\n escape\"", "error": "compile"},
    {"src": "1 # 2", "error": "compile"},
    {"src": "3x", "error": "compile"},
    {"src": "count = 1", "env": {"count": 1}, "error": "compile"}
  ]
}
