{
  "name": "@krotovic/kiln",
  "version": "0.1.0",
  "description": "The browser runtime of Kiln: runs the WebAssembly modules its Go compiler makes. Shipped as TypeScript source, for bundlers and tsx",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krotovic/kiln.git"
  },
  "exports": {
    ".": {
      "types": "./js/src/index.ts",
      "default": "./js/src/index.ts"
    }
  },
  "files": [
    "js/src/*.ts",
    "!js/src/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc -p js/tsconfig.json",
    "test": "node js/scripts/fixtures.mjs && node --import tsx --test \"js/src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
